<mujoco model="DOGURDF">
  <compiler angle="radian" meshdir="./meshes"/>

  <!--
    dogurdf.xml: 16-DoF wheel-legged quadruped, training-ready MJCF.

    Derived from urdf/dogurdf.urdf (SolidWorks export). The auto-converted
    dogurdf_from_urdf.xml has no torso body, no freejoint, no actuators and no
    ground, so it cannot be simulated as a floating-base robot. This file adds
    those, keeping every inertial / joint / collision primitive bit-exact.

    Two properties matter for MJX and are deliberate:

    1. Contact masking. MJX (mujoco 3.4.0) does not implement box<->cylinder
       collisions, and this robot has cylinder wheels next to box thighs and a
       box torso. Every robot geom therefore uses contype=0 conaffinity=1 and
       the floor uses contype=1 conaffinity=0, so the only contact pairs ever
       generated are robot-vs-floor. Self-collision is disabled as a result.

    2. Joint layout. Each leg contributes 4 joints in the order
       hip / thigh / calf / wheel, so the MJX joint order is
       FL(0-3) FR(4-7) RL(8-11) RR(12-15). The policy uses a different
       grouping (12 leg joints, then 4 wheel joints); see robots/dogurdf.py.

    Nominal stance is thigh=0.20 calf=-0.70, which places each wheel centre
    directly under its hip and puts the torso at z=0.347 (wheel radius 0.113).
  -->

  <visual>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="4096"/>
    <map force="0.1" zfar="30"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <option timestep="0.005" iterations="10" ls_iterations="10" solver="Newton" integrator="Euler"
          impratio="10">
    <flag contact="enable" constraint="enable"/>
  </option>

  <!-- armature = PACE 的 I_a 物理基线 = 规格书转子惯量 x 减速比^2（2026-10-05 起，替换原先无依据的统一 0.01）：
         hip/thigh : SEAF90A16NG01  0.11 g.m^2  x 16.221^2 = 2.89e-2 kg.m^2
         calf      : SETZ120CI-1JD   0.346 g.m^2 x 21.333^2 = 1.575e-1 kg.m^2
         wheel     : SEAF90A6NL01    0.11 g.m^2  x 6^2      = 3.96e-3 kg.m^2
       ! 这是【关节侧折算值】（叠加到已含连杆惯量的关节惯量上）；固件寄存器 0x45 的"转子惯量"是【电机侧】
         （1.10e-4 / 3.46e-4），两者差 N^2，勿混用。
       ! 仅含电机转子、不含减速机齿轮 => 属【下限】，真实值可能再高 10~30%。
       ! 轮毂电机不是直驱（减速比 6），故轮子折算惯量是三者最小。 -->
  <default>
    <geom condim="3" friction="1.36 0.005 0.0001" solref="0.035 1.1" solimp="0.9 0.92 0.015"/>
    <joint damping="0.5" armature="0.01"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.3 0.3 0.3" rgb2="0.4 0.4 0.4"
             width="512" height="512" mark="edge" markrgb="0.2 0.2 0.2"/>
    <material name="grid_mat" texture="grid" texrepeat="20 20" texuniform="true"
              reflectance="0.1" shininess="0.1" specular="0.2"/>
    <mesh name="base_link" file="base_link.STL"/>
    <!-- Only the FL meshes exist on disk; the other three legs mirror them,
         matching how urdf/dogurdf.urdf reuses them with negative scale. -->
    <mesh name="FL_hip_mesh" file="FL_hip_link.STL"/>
    <mesh name="FR_hip_mesh" file="FL_hip_link.STL" scale="1 -1 1"/>
    <mesh name="RL_hip_mesh" file="FL_hip_link.STL" scale="-1 1 1"/>
    <mesh name="RR_hip_mesh" file="FL_hip_link.STL" scale="-1 -1 1"/>
    <mesh name="FL_thigh_mesh" file="FL_thigh_link.STL"/>
    <mesh name="FR_thigh_mesh" file="FL_thigh_link.STL" scale="1 -1 1"/>
    <mesh name="RL_thigh_mesh" file="FL_thigh_link.STL"/>
    <mesh name="RR_thigh_mesh" file="FL_thigh_link.STL" scale="1 -1 1"/>
    <mesh name="FL_calf_mesh" file="FL_calf_link.STL"/>
    <mesh name="FR_calf_mesh" file="FL_calf_link.STL" scale="1 -1 1"/>
    <mesh name="RL_calf_mesh" file="FL_calf_link.STL"/>
    <mesh name="RR_calf_mesh" file="FL_calf_link.STL" scale="1 -1 1"/>
    <mesh name="FL_wheel_mesh" file="FL_wheel_link.STL"/>
    <mesh name="FR_wheel_mesh" file="FL_wheel_link.STL" scale="1 -1 1"/>
    <mesh name="RL_wheel_mesh" file="FL_wheel_link.STL"/>
    <mesh name="RR_wheel_mesh" file="FL_wheel_link.STL" scale="1 -1 1"/>
  </asset>

