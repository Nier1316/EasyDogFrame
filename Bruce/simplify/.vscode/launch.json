{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Main (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/can_motor_app",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set print format to hex",
                    "text": "set output-radix 16",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Debug",
            "miDebuggerPath": "/usr/bin/gdb",
            "sourceMap": {},
            "numFormat": "hex"
        },
        {
            "name": "Debug Main (GDB with Args)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/can_motor_app",
            "args": [
                "1"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set print format to hex",
                    "text": "set output-radix 16",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Debug",
            "miDebuggerPath": "/usr/bin/gdb",
            "numFormat": "hex"
        },
        {
            "name": "Attach to Process",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/bin/can_motor_app",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set print format to hex",
                    "text": "set output-radix 16",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb",
            "numFormat": "hex"
        },
        {
            "name": "Debug with Valgrind",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/can_motor_app",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/valgrind",
            "miDebuggerArgs": "--leak-check=full --show-leak-kinds=all --log-file=valgrind.log",
            "preLaunchTask": "Build Debug",
            "numFormat": "hex"
        }
    ],
    "compounds": [
        {
            "name": "Multi Debug",
            "configurations": [
                "Debug Main (GDB)"
            ]
        }
    ]
}
