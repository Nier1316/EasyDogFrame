{
    "configurations": [
        {
            "name": "Linux",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/include/motor_drive",
                "${workspaceFolder}/include/math",
                "${workspaceFolder}/include/thread",
                "${workspaceFolder}/include/bsp",
                "${workspaceFolder}/include/RoboTasks",
                "${workspaceFolder}/lib",
                "${workspaceFolder}/src/base",
                "/usr/include",
                "/usr/include/SDL2",
                "/usr/local/include"
            ],
            "defines": [
                "DEBUG"
            ],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "/usr/include",
                    "/usr/local/include"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": "${workspaceFolder}/.vscode/.browse.VC.db"
            }
        }
    ],
    "version": 4
}
