{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Example 1: Basic Control",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/motor_app",
            "args": ["1"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build",
            "miDebuggerPath": "/usr/bin/gdb"
        },
