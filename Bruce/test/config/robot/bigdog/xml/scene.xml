<mujoco model="bigdog scene">
  <include file="bigdog.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Ascending stairs: 10 steps, riser=10cm, 12cm deep, touching -->
    <geom pos="1.20 0 0.05" type="box" size="0.12 2 0.05" quat="1.0 0 0 0"/>
    <geom pos="1.44 0 0.10" type="box" size="0.12 2 0.10" quat="1.0 0 0 0"/>
    <geom pos="1.68 0 0.15" type="box" size="0.12 2 0.15" quat="1.0 0 0 0"/>
    <geom pos="1.92 0 0.20" type="box" size="0.12 2 0.20" quat="1.0 0 0 0"/>
    <geom pos="2.16 0 0.25" type="box" size="0.12 2 0.25" quat="1.0 0 0 0"/>
    <geom pos="2.40 0 0.30" type="box" size="0.12 2 0.30" quat="1.0 0 0 0"/>
    <geom pos="2.64 0 0.35" type="box" size="0.12 2 0.35" quat="1.0 0 0 0"/>
    <geom pos="2.88 0 0.40" type="box" size="0.12 2 0.40" quat="1.0 0 0 0"/>
    <geom pos="3.12 0 0.45" type="box" size="0.12 2 0.45" quat="1.0 0 0 0"/>
    <geom pos="3.36 0 0.50" type="box" size="0.12 2 0.50" quat="1.0 0 0 0"/>

    <!-- Flat plateau at 1m height (touching) -->
    <geom pos="3.83 0 0.50" type="box" size="0.35 2 0.50" quat="1.0 0 0 0"/>
    <geom pos="4.53 0 0.50" type="box" size="0.35 2 0.50" quat="1.0 0 0 0"/>

    <!-- Ramp: 20° slope down to ground, length=2.92m, horizontal=2.75m, flush with plateau and ground -->
    <geom pos="6.237 0 0.453" type="box" size="1.462 2 0.05" quat="0.9848 0 0.1737 0"/>
  </worldbody>
</mujoco>